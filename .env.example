# ===============================================================
# Copy this file to .env and adjust the values for your machine:
#   cp .env.example .env
# .env is listed in .gitignore and must NEVER be committed.
# Every commented-out key is optional (it already has a default
# in application.properties).
# A Portuguese version of this file is available at
# .env.example.pt-BR
# ===============================================================

# ---------------------------------------------------------------
# APPLICATION / SERVER
# ---------------------------------------------------------------
#APP_NAME=url-shortening
#SERVER_PORT=8080

# ---------------------------------------------------------------
# DATABASE (PostgreSQL) - required
# ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortening
DB_USERNAME=postgres
DB_PASSWORD=change-this-password

# ---------------------------------------------------------------
# CACHE (Redis) - required
# ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_USERNAME=default
REDIS_PASSWORD=password
REDIS_PORT=6379
CACHE_TTL=3600000

# ---------------------------------------------------------------
# CONNECTION POOL (HikariCP) - values in milliseconds
# ---------------------------------------------------------------
#DB_POOL_MAX_SIZE=10
#DB_POOL_MIN_IDLE=5
#DB_POOL_CONNECTION_TIMEOUT=30000
#DB_POOL_IDLE_TIMEOUT=600000
#DB_POOL_MAX_LIFETIME=1800000

# ---------------------------------------------------------------
# JPA / HIBERNATE
# ddl-auto: validate (recommended, schema is managed by Flyway)
#           none | update | create-drop
# ---------------------------------------------------------------
#JPA_DDL_AUTO=validate
#JPA_SHOW_SQL=true
#JPA_FORMAT_SQL=true

# ---------------------------------------------------------------
# FLYWAY
# ---------------------------------------------------------------
#FLYWAY_ENABLED=true
#FLYWAY_BASELINE_ON_MIGRATE=true
